  55          void adc_samp(void)
  56          {
  57   1        ad_result=Get_ADC(16)>>2;
  58   1        if(adc_Temp_Step == 0){
  59   2          ad_result_max = ad_result;
  60   2          ad_result_min = ad_result;
  61   2        }
  62   1        else{
  63   2          if(ad_result_max < ad_result)
  64   2            ad_result_max = ad_result;
  65   2          
  66   2          if(ad_result_min > ad_result)
  67   2            ad_result_min = ad_result;
  68   2          
  69   2          
  70   2        }
  71   1          ad_result_sum = (ad_result_sum + ad_result);  
  72   1        adc_Temp_Step++;
  73   1        if(adc_Temp_Step>=20){
  74   2          adc_Temp_Step=0;
  75   2      
  76   2          ad_result_sum = (ad_result_sum - ad_result_min - ad_result_max);
  77   2          ad_result_sum = (ad_result_sum / 18);
  78   2      
  79   2          ad_NTC_value = ad_result_sum; 
  80   2          ad_result_sum=0;
  81   2      
  82   2          adc_NTC_Temp=Temp_Lookup_dichotomy(ad_NTC_value);
  83   2          }
  84   1      }
