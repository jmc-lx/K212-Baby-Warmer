  22          uint Temp_Lookup_dichotomy(uint ADchanbufer) {
  23   1           uint   Tempchanbufer;
  24   1       if(ADchanbufer>TEMP50){
  25   2              Tempchanbufer=0;
  26   2            }
  27   1            else if(ADchanbufer>TEMP100){
  28   2              Tempchanbufer=50;
  29   2            }
  30   1            else if(ADchanbufer>TEMP150){
  31   2              Tempchanbufer=100;
  32   2            }
  33   1            else if(ADchanbufer>TEMP200){
  34   2              Tempchanbufer=150;
  35   2            }
  36   1            else if(ADchanbufer>TEMP230){
  37   2              Tempchanbufer=200; 
  38   2            }
  39   1            else if(ADchanbufer>TEMP250){
  40   2              Tempchanbufer=230; 
  41   2            }/**/
  42   1            else
  43   1              Tempchanbufer=250; 
  44   1            while(Temp_tab[Tempchanbufer]>ADchanbufer&&Tempchanbufer<250){
  45   2               Tempchanbufer++;
  46   2            }
  47   1            return (Tempchanbufer);
  48   1            
  49   1      }
