  10          uchar CFG_Rb_Rate = 100;     
  11          void CFG_Check(void)
  12          {   
  13   1        unsigned char i = 0;
  14   1        unsigned int  code add_cfg[20] =    
  15   1          {0x81FF,0x83FF,0x83FD,0x83FB,0x83F9,0x83F7,0x83F5,0x83F3,0x83F1,0x83EF,0x83ED,0x83EB,0x83E9,0x83E7,0x83E
             -5,0x83E3,0x83E1,0x83DF,0x83DD,0x83DB};
  16   1        unsigned char code add_cfg_Bit[20] = 
  17   1          {0x3E,   0xFF,  0x1F,  0x3F,  0x3F,  0xFF,  0x3F,  0x1F,  0xEF,  0x07,  0x3F,  0xFF,  0x37,  0xFF,  0xFF,  0
             -xFF,  0x3F,  0xFF,  0xFF,  0xFF,};
  18   1        uint rom_offset = 0;
  19   1        
  20   1        EA = 0;//关总中断
  21   1        REG_ADDR = 0x24;
  22   1        rom_offset = ((uint)REG_DATA)<<8;
  23   1        REG_ADDR = 0x23;
  24   1        rom_offset |= REG_DATA;
  25   1        for(i = 0; i < 20;i++)
  26   1        {
  27   2          REG_ADDR = i;
  28   2      
  29   2          if((CBYTE[add_cfg[i]-rom_offset]&add_cfg_Bit[i]) != (REG_DATA&add_cfg_Bit[i]))
  30   2          {
  31   3            SOFT_RST = 0x55;
  32   3          } 
  33   2        }
  34   1        if((CBYTE[0x83CD-rom_offset] >= 64)&&(CBYTE[0x83CD-rom_offset] <= 96))
  35   1        {
  36   2          CFG_Rb_Rate = ((ulong)(CBYTE[0x83CD-rom_offset]*100)/80);
  37   2        }
  38   1        P2_XH = 0;//使用MOVX 操作PDATA区时，P2_XH清0
  39   1        EA = 1;//开总中断 
  40   1        
  41   1      }
